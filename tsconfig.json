{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "@moodly/shared": ["./packages/shared/src/index.ts"],
      "@moodly/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "taro", "dist", "packages"]
}
